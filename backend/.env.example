# ===================================================
# FitTrack Backend - Variables de Entorno
# ===================================================

# Clave secreta de Django (en producción usar una clave segura y aleatoria)
SECRET_KEY=unsafe-secret-for-dev

# Modo depuración (True para desarrollo local, False en producción)
DEBUG=True

# ---------------------------------------------------
# Configuración MySQL (Variables individuales)
# ---------------------------------------------------
DB_NAME=fittrack
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------
# Alternativa: Configuración mediante DATABASE_URL
# Si se define DATABASE_URL, tendrá prioridad sobre las variables individuales.
# ---------------------------------------------------
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/fittrack

# ---------------------------------------------------
# Creación automática de superusuario (opcional para scripts)
# ---------------------------------------------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=adminpassword
